# Copy to server/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug
DATABASE_URL=postgres://taskhub:taskhub@localhost:5432/taskhub
# Used by the automated tests (separate database, wiped on every run)
TEST_DATABASE_URL=postgres://taskhub:taskhub@localhost:5432/taskhub_test
DB_POOL_MAX=10
# Signing secret for access tokens (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT_MAX=20
